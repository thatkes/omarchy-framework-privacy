#!/usr/bin/env python3
"""Toggle the Framework privacy bar indicators from the command line."""

from __future__ import annotations

import argparse
import json
import sys

import status as backend

DEVICES_HELP = "microphone|mic|camera|webcam"


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="framework-privacy",
        description="Show or hide the Framework microphone and camera privacy indicators.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status_parser = sub.add_parser("status", help="show hardware, activity and indicator state")
    status_parser.add_argument("device", nargs="?", help=DEVICES_HELP)
    status_parser.add_argument("--json", action="store_true", help="print raw JSON")

    for command in ("on", "off", "toggle"):
        control = sub.add_parser(command, help=f"turn {command} an indicator")
        control.add_argument("device", help=DEVICES_HELP)

    args = parser.parse_args()

    try:
        if args.command == "status":
            devices = (
                [backend.normalize_device(args.device)]
                if args.device
                else list(backend.DEVICES)
            )
            results = {device: backend.get_status(device) for device in devices}
            if args.json:
                payload = results if len(devices) > 1 else results[devices[0]]
                print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
            else:
                for device in devices:
                    item = results[device]
                    state = "on" if item["enabled"] else "off"
                    print(
                        f"{item['label']}: {item['state']} | indicator: {state} "
                        f"| hardware: {item['hardware']} | activity: {item['activity']}"
                    )
            return 0

        device = backend.normalize_device(args.device)
        enabled = args.command == "on" or (
            args.command == "toggle" and not backend.read_visibility()[device]
        )
        backend.write_visibility(device, enabled)
        print(f"{backend.DEVICES[device]['label']} indicator {'on' if enabled else 'off'}")
        return 0
    except ValueError as error:
        print(f"framework-privacy: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
